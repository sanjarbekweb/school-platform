# Payload CMS & Next.js Environment Variables

# Secure secret used to sign session cookies and JWTs (generate 32+ random characters)
PAYLOAD_SECRET=school_platform_super_secret_payload_key_2026_dev

# Database Connection URI
# Local Development & Testing: SQLite file (zero external daemon required)
DATABASE_URI=file:./school.db

# Production PostgreSQL example:
# DATABASE_URI=postgresql://maktab_user:secret_password@127.0.0.1:5432/maktab_platform

# Public application base URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Environment mode
NODE_ENV=development
